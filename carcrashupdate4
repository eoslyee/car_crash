# Animation Window
scene.width = 750
scene.height = 200
scene.background = color.gray(0.15)
scene.camera.pos  = vec(0, 6, 18)
scene.camera.axis = vec(0, -3, -18)
scene.userzoom = False

g_accel  = 9.8

# Simulation state
state = {
    "surface": "Asphalt",
    "car_type": "Medium",
    "target_type": "Tree",
    "car_speed": 25.0,
    "target_speed": 0.0,
    "running": False,
    "collided": False,
    "post_collision": False,
    "dt": 0.005,
}

# Surface data
