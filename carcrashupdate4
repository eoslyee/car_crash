status_text = wtext(text="<b>Status:</b> Press Start to run.")
scene.append_to_caption("  ")

def start_sim(b):
    sd = surface_data[state["surface"]]
    state["running"] = True
    state["collided"] = False
    state["post_collision"] = False
    state["car_speed"] = sd["initial_speed"]
    state["target_speed"] = 0.0
    build_car(state["car_type"])
    build_target(state["target_type"])
    status_text.text = "<b>Status:</b> Running..."

button(text="Start / Restart", bind=start_sim)

# Initial scene
build_car(state["car_type"])
build_target(state["target_type"])

# Animation loop 
dt = state["dt"]

while True:
    rate(200)

    if not state["running"]:
        continue

    mu = surface_data[state["surface"]]["mu"]

    # Pre-collision
    if not state["collided"]:
        acc = -mu * g_accel / (car_selection[state["car_type"]]["mass"])
        state["car_speed"] += acc * dt
        if state["car_speed"] < 0:
            state["car_speed"] = 0
            state["running"]   = False
            status_text.text   = "<b>Status:</b> Car stopped before collision."

        dx = state["car_speed"] * dt
        for part in current_car:
            part.pos.x += dx

        car_body_x = current_car[-2].pos.x
        if car_body_x >= TARGET_X - 2.0:
            # Collision moment — compute elastic post-collision velocities
            state["collided"] = True
            m1 = car_selection[state["car_type"]]["mass"]
            m2 = target_selection[state["target_type"]]["mass"]
            v1 = state["car_speed"]
            v1_f, v2_f = compute_elastic_velocities(v1, m1, m2)
            state["car_speed"]    = v1_f
            state["target_speed"] = v2_f

            t_name = state["target_type"]
            if t_name == "Deer":
                status_text.text = "<b>Status:</b> Collision! Moose launched forward, car barely slowed."
            elif t_name == "Tree":
                status_text.text = "<b>Status:</b> Collision! Car bounced back and the tree barely moved."
            elif t_name == "Truck":
                status_text.text = "<b>Status:</b> Collision! Car bounced back hard and the truck barely moved."
            elif t_name == "Parked Car":
                status_text.text = "<b>Status:</b> Collision! Both cars exchange speed."

    # Post-collision: both objects move and decelerate from friction
    else:
        #car 
        if state["car_speed"] > 0:
            state["car_speed"] -= mu * g_accel * dt
            if state["car_speed"] < 0:
                state["car_speed"] = 0
        elif state["car_speed"] < 0:
            state["car_speed"] += mu * g_accel * dt
            if state["car_speed"] > 0:
                state["car_speed"] = 0

        # Target 
        if state["target_speed"] > 0:
            state["target_speed"] -= (mu * g_accel)/(target_selection[state["target_type"]]["mass"]) * dt
            if state["target_speed"] < 0:
                state["target_speed"] = 0

        dx_car    = state["car_speed"]    * dt
        dx_target = state["target_speed"] * dt

        for part in current_car:
            part.pos.x += dx_car
        for part in current_target:
            part.pos.x += dx_target

        # Stop simulation when everythings done
        if state["car_speed"] == 0 and state["target_speed"] == 0:
            state["running"] = False
            status_text.text = "<b>Status:</b> Simulation complete."
