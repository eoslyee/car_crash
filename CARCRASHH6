# ─── Scene ────────────────────────────────────────────────────────────────────
scene.width  = 800
scene.height = 220
scene.background = color.gray(0.15)
scene.camera.pos  = vec(0, 6, 18)
scene.camera.axis = vec(0, -3, -18)
scene.userzoom = False

G        = 9.8     # m/s²
TARGET_X = 20      # x-position of target
DT       = 0.005   # physics timestep (s)

# ─── Simulation state ─────────────────────────────────────────────────────────
state = {
    "surface":      "Asphalt",
    "car_type":     "Medium",
    "target_type":  "Tree",
    "car_speed":    0.0,
    "target_speed": 0.0,
    "running":      False,
    "collided":     False,
    "elasticity":   0.5,
}

# ─── Surface data ─────────────────────────────────────────────────────────────
# Realistic kinetic friction coefficients:
#   Asphalt (dry rubber):  μ ≈ 0.7–0.8
#   Wet road:              μ ≈ 0.4–0.5
#   Ice:                   μ ≈ 0.05–0.1
surface_data = {
    "Asphalt": {
        "mu_car":    0.75,
        "mu_target": 0.75,
        "initial_speed": 25.0,    # ≈ 90 km/h
        "ground_col":  color.gray(0.32),
        "line_col":    color.white,
        "line_opacity": 0.55,
    },
    "Wet Road": {
        "mu_car":    0.45,
        "mu_target": 0.45,
        "initial_speed": 25.0,
        "ground_col":  vec(0.20, 0.26, 0.36),
        "line_col":    vec(0.55, 0.65, 0.80),
        "line_opacity": 0.35,
    },
    "Ice": {
        "mu_car":    0.07,
        "mu_target": 0.07,
        "initial_speed": 25.0,
        "ground_col":  vec(0.70, 0.85, 0.95),
        "line_col":    color.white,
        "line_opacity": 0.20,
    },
}

# ─── Car data ─────────────────────────────────────────────────────────────────
# Realistic car masses:
#   Small car (e.g. Honda Fit):   ~1050 kg
#   Medium sedan (e.g. Camry):    ~1500 kg
#   Large SUV/truck (e.g. F-150): ~2200 kg
car_data = {
    "Small":  {"mass": 1050,  "scale": 0.75, "color": color.red},
    "Medium": {"mass": 1500,  "scale": 1.00, "color": color.blue},
    "Large":  {"mass": 2200,  "scale": 1.50, "color": color.green},
}

# ─── Target data ──────────────────────────────────────────────────────────────
# Realistic masses & behavior:
#   Tree      → rooted to earth; treat as immovable (mass = ∞ effectively).
#               Use wall-collision formula: v_car_f = -e * v_car.
#               "immovable" flag triggers special handling.
#
#   Parked Car → ~1500 kg sedan with brakes on.
#               Brakes provide static friction holding ~0.8 g before sliding.
#               After collision overcomes brakes, slides with μ ≈ 0.75.
#               friction_mult = 1.0 (brakes release at impact in our model).
#
#   Moose      → Bull moose: 450–600 kg. Use 500 kg.
#               Biological, no brakes. Low e (flesh absorbs energy).
#               friction_mult = 0.8 (hooves on road, some grip).
#
#   Truck      → Loaded semi: ~15,000 kg. Brakes on, parked.
#               Effectively immovable for most car collisions.
#               But NOT rooted like a tree — it can move, just barely.
#               friction_mult = 3.0 (heavy + brakes).
target_data = {
    "Tree":       {"mass": 1e30,  "immovable": True,  "friction_mult": 1.0,
                   "e_cap": 0.4},   # e_cap: max realistic e regardless of slider
    "Parked Car": {"mass": 1500,  "immovable": False, "friction_mult": 1.0,
                   "e_cap": 0.7},
    "Moose":      {"mass": 500,   "immovable": False, "friction_mult": 0.8,
                   "e_cap": 0.4},   # biological — energy absorbed by body
    "Truck":      {"mass": 15000, "immovable": False, "friction_mult": 3.0,
                   "e_cap": 0.5},
}

# ─── Scene objects ────────────────────────────────────────────────────────────
