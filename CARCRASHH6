    pos=vec(0, -0.3, 0), size=vec(120, 0.3, 8),
    color=surface_data["Asphalt"]["ground_col"], texture=textures.rough)

road_lines = []
for xpos in range(-58, 62, 4):
    road_lines.append(box(
        pos=vec(xpos, -0.14, 0), size=vec(2, 0.02, 0.3),
        color=surface_data["Asphalt"]["line_col"],
        opacity=surface_data["Asphalt"]["line_opacity"]))

puddles = []
for xp in [-40, -28, -14, -6, 2, 10, 22, 34, 44]:
    puddles.append(box(
        pos=vec(xp, -0.145, 1.2), size=vec(3.5, 0.01, 1.0),
        color=vec(0.35, 0.48, 0.65), opacity=0.0))

ice_streaks = []
for xp in range(-55, 58, 6):
    ice_streaks.append(box(
        pos=vec(xp, -0.145, 0), size=vec(0.25, 0.01, 7.5),
        color=color.white, opacity=0.0))

def apply_surface(name):
    sd = surface_data[name]
    ground.color = sd["ground_col"]
    for ln in road_lines:
        ln.color   = sd["line_col"]
        ln.opacity = sd["line_opacity"]
    for p in puddles:
        p.opacity = 0.45 if name == "Wet Road" else 0.0
    for s in ice_streaks:
        s.opacity = 0.18 if name == "Ice" else 0.0

apply_surface("Asphalt")

# ─── Object builders ──────────────────────────────────────────────────────────
current_car    = []
current_target = []

def clear_list(lst):
    for obj in lst:
        obj.visible = False
    lst.clear()

def build_car(car_type, start_x=-20):
    clear_list(current_car)
    info  = car_data[car_type]
    scale = info["scale"]
    col   = info["color"]
    r = 0.32 * scale
    wheel_pos = [
        vec(start_x + 1.1*scale, r,  0.95*scale),
        vec(start_x + 1.1*scale, r, -0.95*scale),
        vec(start_x - 1.1*scale, r,  0.95*scale),
        vec(start_x - 1.1*scale, r, -0.95*scale),
    ]
    for wp in wheel_pos:
        current_car.append(cylinder(pos=wp, axis=vec(0,0,0.2), radius=r, color=color.gray(0.2)))
    current_car.append(box(pos=vec(start_x, 0.45*scale, 0),
        size=vec(3.5*scale, 0.8*scale, 1.8*scale), color=col))
    current_car.append(box(pos=vec(start_x - 0.2*scale, (0.45+0.65)*scale, 0),
        size=vec(1.8*scale, 0.65*scale, 1.6*scale), color=col*0.75))

def build_tree(tx):
    current_target.append(cylinder(pos=vec(tx,0,0), axis=vec(0,2.5,0),
        radius=0.25, color=vec(0.4,0.25,0.1)))
    current_target.append(cone(pos=vec(tx,2.0,0), axis=vec(0,2.5,0),
        radius=1.4, color=color.green))
    current_target.append(cone(pos=vec(tx,3.2,0), axis=vec(0,2.0,0),
        radius=1.0, color=vec(0.1,0.6,0.1)))
    current_target.append(cone(pos=vec(tx,4.2,0), axis=vec(0,1.5,0),
        radius=0.65, color=vec(0.05,0.5,0.05)))

def build_parked_car(tx):
    r = 0.32
    wheel_pos = [
        vec(tx+1.1,r,0.95), vec(tx+1.1,r,-0.95),
        vec(tx-1.1,r,0.95), vec(tx-1.1,r,-0.95),
    ]
    for wp in wheel_pos:
        current_target.append(cylinder(pos=wp, axis=vec(0,0,0.2), radius=r, color=color.gray(0.2)))
    current_target.append(box(pos=vec(tx,0.45,0),
        size=vec(3.5,0.8,1.8), color=color.cyan))
    current_target.append(box(pos=vec(tx-0.2,1.1,0),
        size=vec(1.8,0.65,1.6), color=color.cyan*0.75))

def build_moose(tx):
    leg_pos = [
        vec(tx+0.5,0.5,0.2), vec(tx+0.5,0.5,-0.2),
        vec(tx-0.5,0.5,0.2), vec(tx-0.5,0.5,-0.2),
    ]
    for lp in leg_pos:
        current_target.append(cylinder(pos=lp, axis=vec(0,-0.5,0),
            radius=0.07, color=vec(0.5,0.33,0.15)))
    current_target.append(cylinder(pos=vec(tx+1.05,1.55, 0.1), axis=vec(0.1,0.4, 0.15), radius=0.04, color=vec(0.35,0.22,0.08)))
    current_target.append(cylinder(pos=vec(tx+1.05,1.55,-0.1), axis=vec(0.1,0.4,-0.15), radius=0.04, color=vec(0.35,0.22,0.08)))
    current_target.append(ellipsoid(pos=vec(tx,0.85,0),    size=vec(3.6,1.4,1.3), color=vec(0.6,0.4,0.2)))
    current_target.append(ellipsoid(pos=vec(tx+1.1,1.35,0),size=vec(1.1,0.9,0.8), color=vec(0.6,0.4,0.2)))
    current_target.append(cylinder(pos=vec(tx+0.75,0.95,0), axis=vec(0.35,0.45,0),
        radius=0.18, color=vec(0.6,0.4,0.2)))

def build_truck(tx):
    r2 = 0.5
    truck_wp = [
        vec(tx+2.2,r2,1.15), vec(tx+2.2,r2,-1.15),
        vec(tx-0.5,r2,1.15), vec(tx-0.5,r2,-1.15),
        vec(tx-2.5,r2,1.15), vec(tx-2.5,r2,-1.15),
    ]
    for wp in truck_wp:
        current_target.append(cylinder(pos=wp, axis=vec(0,0,0.25), radius=r2, color=color.gray(0.15)))
    current_target.append(box(pos=vec(tx+2.5,1.1,0),  size=vec(2.5,2.2,2.2),  color=color.red))
    current_target.append(box(pos=vec(tx+3.6,1.6,0),  size=vec(0.1,1.0,1.8),  color=vec(0.6,0.8,1.0)))
    current_target.append(box(pos=vec(tx-1.5,1.25,0), size=vec(6.0,2.5,2.2),  color=color.gray(0.55)))
    current_target.append(box(pos=vec(tx-1.5,2.45,0), size=vec(6.0,0.12,2.22),color=color.red))

def build_target(target_type):
    clear_list(current_target)
    tx = TARGET_X
    if   target_type == "Tree":       build_tree(tx)
    elif target_type == "Parked Car": build_parked_car(tx)
    elif target_type == "Moose":      build_moose(tx)
    elif target_type == "Truck":      build_truck(tx)

# ─── Collision physics ────────────────────────────────────────────────────────
# Standard 1-D collision with coefficient of restitution e ∈ [0,1]:
#   v1_f = (m1·v1 + m2·v2 − m2·e·(v1−v2)) / (m1+m2)
#   v2_f = (m1·v1 + m2·v2 + m1·e·(v1−v2)) / (m1+m2)
#
# Special case — immovable object (tree):
#   The tree is rooted to the earth; momentum is transferred to the planet.
#   v_car_f = -e · v_car  (wall bounce formula)
#   v_tree  = 0 always
def collision_velocities(v1, v2, m1, m2, e, immovable=False):
    if immovable:
        # Wall (infinite-mass) collision: car reverses with factor e
        return -e * v1, 0.0
    v1_f = (m1*v1 + m2*v2 - m2*e*(v1 - v2)) / (m1 + m2)
    v2_f = (m1*v1 + m2*v2 + m1*e*(v1 - v2)) / (m1 + m2)
    return v1_f, v2_f

# ─── Graphs ───────────────────────────────────────────────────────────────────
# Graph 1 – Kinetic Energy vs Time
ke_graph = graph(
    title="Kinetic Energy vs Time (J)",
    xtitle="Time (s)", ytitle="KE (J)",
    width=540, height=230,
    background=color.gray(0.1), foreground=color.white)
ke_car_curve    = gcurve(graph=ke_graph, color=color.yellow, label="Car KE")
ke_target_curve = gcurve(graph=ke_graph, color=color.cyan,   label="Target KE")
ke_total_curve  = gcurve(graph=ke_graph, color=color.white,  label="Total KE")

# Graph 2 – Momentum vs Time
# NOTE: When target is immovable (Tree), system momentum is NOT conserved
# because the tree transfers impulse to the Earth.  We still plot car & target
# separately and clearly label this.
p_graph = graph(
    title="Momentum vs Time (kg·m/s)",
    xtitle="Time (s)", ytitle="Momentum (kg·m/s)",
    width=540, height=230,
    background=color.gray(0.1), foreground=color.white)
p_car_curve    = gcurve(graph=p_graph, color=color.yellow, label="Car p")
p_target_curve = gcurve(graph=p_graph, color=color.cyan,   label="Target p")
p_total_curve  = gcurve(graph=p_graph, color=color.white,  label="System p*")

# Graph 3 – KE Lost vs Elasticity (accumulates across runs)
# Uses gdots so each run is clearly visible as a distinct point/bar.
# delta is set wide (0.08) so bars are clearly visible.
ke_bar_graph = graph(
    title="KE Lost at Impact vs Elasticity  (run multiple times to populate)",
    xtitle="Elasticity  e", ytitle="KE Lost (J)",
    width=540, height=230,
    xmin=-0.05, xmax=1.05,
    background=color.gray(0.1), foreground=color.white)
ke_lost_bars = gvbars(graph=ke_bar_graph, color=color.orange, delta=0.05, label="KE Lost")

def reset_time_graphs():
    ke_car_curve.delete()
    ke_target_curve.delete()
    ke_total_curve.delete()
    p_car_curve.delete()
    p_target_curve.delete()
    p_total_curve.delete()

