scene.append_to_caption("  ")

def change_e(sl):
    state["elasticity"] = sl.value
    v = sl.value
    if   v >= 0.99: desc = "perfectly elastic"
    elif v <= 0.01: desc = "perfectly inelastic (full crumple)"
    elif v >= 0.75: desc = "mostly elastic"
    elif v >= 0.45: desc = "partially inelastic"
    else:           desc = "mostly inelastic"
    elasticity_label.text = "{:.2f}  ({})  ← adjust, then hit Start".format(v, desc)

e_slider = slider(min=0.0, max=1.0, value=0.5, step=0.01, bind=change_e)
scene.append_to_caption("\n\n")

scene.append_to_caption(
    "<i>Note: Tree uses wall-collision (immovable). "
    "Truck & Moose e is capped to realistic max regardless of slider.</i>\n\n")

def start_sim(b):
    sd = surface_data[state["surface"]]
    state["running"]      = True
    state["collided"]     = False
    state["car_speed"]    = sd["initial_speed"]
    state["target_speed"] = 0.0
    build_car(state["car_type"])
    build_target(state["target_type"])
    reset_time_graphs()
    status_text.text = "<b>Status:</b> Running…"

button(text="▶  Start / Restart", bind=start_sim)
scene.append_to_caption("\n")

# ─── Initial scene ────────────────────────────────────────────────────────────
build_car(state["car_type"])
build_target(state["target_type"])

# ─── Main loop ────────────────────────────────────────────────────────────────
sim_time   = 0.0
step_count = 0
GRAPH_EVERY = 8   # plot every N physics steps to keep graphs from being too dense

while True:
    rate(200)

    if not state["running"]:
        continue

    sd   = surface_data[state["surface"]]
    mu_c = sd["mu_car"]
    mu_t = sd["mu_target"]
    m1   = car_data[state["car_type"]]["mass"]
    td   = target_data[state["target_type"]]
    m2   = td["mass"]
    fm   = td["friction_mult"]
    immov = td["immovable"]

    # ── Pre-collision: car decelerates under rolling/road friction ────────────
    if not state["collided"]:
        # Deceleration magnitude = μ·g  (mass cancels in F=ma)
        state["car_speed"] -= mu_c * G * DT
        if state["car_speed"] <= 0:
            state["car_speed"] = 0.0
            state["running"]   = False
            status_text.text   = "<b>Status:</b> Car stopped before reaching target."

        dx = state["car_speed"] * DT
        for part in current_car:
            part.pos.x += dx

        # Collision trigger: front of car body reaches target zone
        car_front_x = current_car[-2].pos.x + 1.75 * car_data[state["car_type"]]["scale"]
        if car_front_x >= TARGET_X - 0.5:
            state["collided"] = True

            v1 = state["car_speed"]
            v2 = 0.0

            # Cap elasticity to what is physically realistic for each target
            e_used = min(state["elasticity"], td["e_cap"])

            ke_before = 0.5 * m1 * v1**2

            v1_f, v2_f = collision_velocities(v1, v2, m1, m2, e_used, immovable=immov)
            state["car_speed"]    = v1_f
            state["target_speed"] = v2_f

            ke_after = 0.5 * m1 * v1_f**2
            if not immov:
                ke_after += 0.5 * m2 * v2_f**2
            ke_lost = ke_before - ke_after

            # Plot on bar graph — one dot per run so user can sweep e
            ke_lost_bars.plot(e_used, ke_lost)

            t = state["target_type"]
            if   t == "Tree":
                status_text.text = (
                    "<b>Status:</b> BOOM — tree is immovable! "
                    "Car bounces back at {:.1f} m/s. "
                    "KE lost to crumple/sound: {:.0f} kJ".format(
                        abs(v1_f), ke_lost/1000))
            elif t == "Moose":
                status_text.text = (
                    "<b>Status:</b> Moose struck! "
                    "Car: {:.1f} → {:.1f} m/s.  "
                    "Moose flung at {:.1f} m/s. "
                    "KE lost: {:.0f} kJ".format(
                        v1, v1_f, v2_f, ke_lost/1000))
            elif t == "Truck":
                status_text.text = (
                    "<b>Status:</b> Hit the semi! "
                    "Car: {:.1f} → {:.1f} m/s.  "
                    "Truck barely moves: {:.2f} m/s. "
                    "KE lost: {:.0f} kJ".format(
                        v1, v1_f, v2_f, ke_lost/1000))
            elif t == "Parked Car":
                status_text.text = (
                    "<b>Status:</b> T-boned the parked car! "
                    "Car: {:.1f} → {:.1f} m/s.  "
                    "Parked car: {:.1f} m/s. "
                    "KE lost: {:.0f} kJ".format(
                        v1, v1_f, v2_f, ke_lost/1000))

    # ── Post-collision: friction slows both objects independently ─────────────
    else:
        # ── Car ──
        if state["car_speed"] > 0:
            state["car_speed"] -= mu_c * G * DT
            if state["car_speed"] < 0: state["car_speed"] = 0.0
        elif state["car_speed"] < 0:
            state["car_speed"] += mu_c * G * DT
            if state["car_speed"] > 0: state["car_speed"] = 0.0

        # ── Target (only moves if not immovable) ──
        if not immov:
            if state["target_speed"] > 0:
                state["target_speed"] -= mu_t * fm * G * DT
                if state["target_speed"] < 0: state["target_speed"] = 0.0
            elif state["target_speed"] < 0:
                state["target_speed"] += mu_t * fm * G * DT
                if state["target_speed"] > 0: state["target_speed"] = 0.0

        for part in current_car:
            part.pos.x += state["car_speed"] * DT
        for part in current_target:
            part.pos.x += state["target_speed"] * DT

        if state["car_speed"] == 0.0 and state["target_speed"] == 0.0:
            state["running"] = False
            status_text.text = "<b>Status:</b> Simulation complete. ✓"

    # ── Graph updates ─────────────────────────────────────────────────────────
    sim_time   += DT
    step_count += 1

    if step_count % GRAPH_EVERY == 0:
        v1 = state["car_speed"]
        v2 = state["target_speed"] if state["collided"] else 0.0

        ke_car    = 0.5 * m1 * v1**2
        ke_target = 0.5 * m2 * v2**2 if not immov else 0.0
        ke_total  = ke_car + ke_target

        # Momentum (signed — negative = leftward)
        p_car    = m1 * v1
        p_target = m2 * v2 if not immov else 0.0
        p_total  = p_car + p_target

        ke_car_curve.plot(sim_time,    ke_car)
        ke_target_curve.plot(sim_time, ke_target)
        ke_total_curve.plot(sim_time,  ke_total)

        p_car_curve.plot(sim_time,    p_car)
        p_target_curve.plot(sim_time, p_target)
        p_total_curve.plot(sim_time,  p_total)
